# ================  IMAP ====================
set imap_user = d.douglas.carr@gmail.com
set imap_pass="`pass ddouglascarr-gmail`"
set spoolfile = imaps://imap.gmail.com/INBOX
set folder = imaps://imap.gmail.com/
set record="imaps://imap.gmail.com/[Gmail]/Sent Mail"
set postponed="imaps://imap.gmail.com/[Gmail]/Drafts"
set mbox="imaps://imap.gmail.com/[Gmail]/All Mail"
set header_cache = "~/.mutt/cache/headers"
set message_cachedir = "~/.mutt/cache/bodies"
set certificate_file = "~/.mutt/certificates"
# ================  SMTP  ====================
set smtp_url = "smtp://d.douglas.carr@smtp.gmail.com:587/"
set smtp_pass = $imap_pass
set ssl_force_tls = yes # Require encrypted connection
set smtp_authenticators = 'gssapi:login'
# ================  Composition  ====================
set editor = "nvim"      # Set your favourite editor.
set edit_headers = yes  # See the headers when editing
set charset = UTF-8     # value of $LANG; also fallback for send_charset
# Sender, email address, and sign-off line must match
unset use_domain        # because joe@localhost is just embarrassing
set realname = "Daniel Carr"
set from = "d.douglas.carr@gmail.com"
set use_from = yes
set text_flowed = yes
set send_charset = UTF-8
# ================  Reading ================ 
set mailcap_path   = ~/.mutt/mailcap
# alternative_order text/plain text/html
auto_view = "text/html"
macro attach 'V' "<pipe-entry>iconv -c --to-code=UTF8 > ~/.cache/mutt-mail.html<enter><shell-escape>open -a Firefox ~/.cache/mutt-mail.html<enter>"

# ================ Theme================  
source ~/.mutt/theme/tomorrow-night-eighties.muttrc
