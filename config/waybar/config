{
  "layer": "top",
  "position": "top",
  "modules-left": [
    "sway/workspaces"
  ],
  "modules-right": [
    "battery",
    "clock"
  ],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true
  },
  "battery": {
    "interval": 5,
    "format": "🔋 {capacity}%",
    "format-discharging": "🔋 {capacity}%",
    "format-charging": "⚡ {capacity}%",
    "format-full": "🔌 {capacity}%"
  },
  "clock": {
    "interval": 5,
    "format": "{:%Y-%m-%d %H:%M}"
  }
}
